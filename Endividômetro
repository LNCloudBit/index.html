  <!-- SCRIPT LÓGICO DO QUIZ E VELOCÍMETRO -->
  <script>
    let currentStep = 1;
    const totalSteps = 4;

    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');

    nextBtn.addEventListener('click', () => {
      const currentRadio = document.querySelector(`.quiz-step[data-step="${currentStep}"] input[type="radio"]:checked`);
      
      if (!currentRadio) {
        alert("Por favor, selecione uma opção para avançar.");
        return;
      }

      if (currentStep < totalSteps) {
        document.querySelector(`.quiz-step[data-step="${currentStep}"]`).classList.add('hidden');
        currentStep++;
        document.querySelector(`.quiz-step[data-step="${currentStep}"]`).classList.remove('hidden');
        updateProgress();
      } else {
        calculateAndShowResult();
      }
    });

    prevBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        document.querySelector(`.quiz-step[data-step="${currentStep}"]`).classList.add('hidden');
        currentStep--;
        document.querySelector(`.quiz-step[data-step="${currentStep}"]`).classList.remove('hidden');
        updateProgress();
      }
    });

    function updateProgress() {
      prevBtn.disabled = (currentStep === 1);
      nextBtn.innerText = (currentStep === totalSteps) ? "Ver Meu Diagnóstico →" : "Próxima Pergunta";
      progressBar.style.width = `${(currentStep / totalSteps) * 100}%`;
      progressText.innerText = `Pergunta ${currentStep} de ${totalSteps}`;
    }

    function calculateAndShowResult() {
      const q1 = parseFloat(document.querySelector('input[name="q1"]:checked').value);
      const q2 = parseFloat(document.querySelector('input[name="q2"]:checked').value);
      const q3 = parseFloat(document.querySelector('input[name="q3"]:checked').value);
      const q4 = parseFloat(document.querySelector('input[name="q4"]:checked').value);

      let score = Math.min(10, Math.max(0, q1 + q2 + q3 + q4));
      score = Math.round(score * 10) / 10;

      document.getElementById('quiz-container').classList.add('hidden');
      document.getElementById('hero-section').classList.add('hidden');
      document.getElementById('result-container').classList.remove('hidden');

      document.getElementById('score-display').innerHTML = `${score} <span class="text-lg font-bold text-slate-500">/ 10</span>`;

      const angle = -90 + (score / 10) * 180;
      
      setTimeout(() => {
        document.getElementById('gauge-pointer').style.transform = `rotate(${angle}deg)`;
      }, 200);

      const statusBadge = document.getElementById('status-badge');
      const diagnosisCard = document.getElementById('diagnosis-card');

      if (score <= 4) {
        statusBadge.className = "inline-block mt-2 px-4 py-1.5 rounded-full font-bold text-sm bg-emerald-500/20 text-emerald-400 border border-emerald-500/30";
        statusBadge.innerText = "Nível Verde (0 a 4) — Finanças Sob Controle";

        diagnosisCard.innerHTML = `
          <h4 class="text-xl font-bold text-emerald-400">Excelente! Suas contas estão estruturadas.</h4>
          <p class="text-slate-300 text-sm leading-relaxed">
            Você não está no sufoco das dívidas abusivas. O seu grande objetivo agora é acelerar a construção da sua reserva de paz e fazer o seu dinheiro render mais em renda fixa segura.
          </p>
        `;
      } else if (score <= 7) {
        statusBadge.className = "inline-block mt-2 px-4 py-1.5 rounded-full font-bold text-sm bg-amber-500/20 text-amber-400 border border-amber-500/30";
        statusBadge.innerText = "Nível Amarelo (5 a 7) — Alerta de Limite";

        diagnosisCard.innerHTML = `
          <h4 class="text-xl font-bold text-amber-400">Atenção! Você está no limite da margem de segurança.</h4>
          <p class="text-slate-300 text-sm leading-relaxed">
            As suas contas estão em dia, mas você vive sem folga. Qualquer imprevisto pode te jogar no cheque especial. É hora de eliminar vazamentos invisíveis e começar a guardar pequenos valores para criar fôlego.
          </p>
        `;
      } else {
        statusBadge.className = "inline-block mt-2 px-4 py-1.5 rounded-full font-bold text-sm bg-rose-500/20 text-rose-400 border border-rose-500/30";
        statusBadge.innerText = "Nível Vermelho (8 a 10) — Sufoco e Sangramento";

        diagnosisCard.innerHTML = `
